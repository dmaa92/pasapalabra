# Copy to .env for local overrides. .env is gitignored; never commit it.
# Nothing here is required — the app starts with no environment at all.

# uvicorn log level: critical|error|warning|info|debug|trace
LOG_LEVEL=info

# Only the `tools` profile reads this (question generation, ADR-0008).
# The deployed app never sees it and cannot use it.
# ANTHROPIC_API_KEY=

# The host port, the interface it binds to and the container's resource
# limits are written literally in docker-compose.yml, not taken from the
# environment: the platform this is deployed on does not interpolate
# ${VAR}. Change them in that file.
