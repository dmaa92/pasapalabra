# Copy to .env for local overrides. .env is gitignored; never commit it.
# Nothing here is required — the app starts with no environment at all.

# Host port for the local stack (container always listens on 8000).
APP_PORT=8080

# Host interface to bind. Loopback by default, so the stack is reachable
# only from this machine. The app has no authentication of any kind, so
# 0.0.0.0 means anyone who can reach this host can open the board and
# start matches — a deliberate exposure decision, see docs/security.md.
APP_BIND=127.0.0.1

# uvicorn log level: critical|error|warning|info|debug|trace
LOG_LEVEL=info

# Container resource limits used by docker-compose.yml.
APP_MEM_LIMIT=256m
APP_CPU_LIMIT=0.5
APP_PIDS_LIMIT=128
