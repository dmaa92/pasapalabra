# Copy to .env for local overrides. .env is gitignored; never commit it.
# Nothing here is required — the app starts with no environment at all.

# Host port for the local stack (container always listens on 8000).
APP_PORT=8080

# uvicorn log level: critical|error|warning|info|debug|trace
LOG_LEVEL=info

# Container resource limits used by docker-compose.yml.
APP_MEM_LIMIT=256m
APP_CPU_LIMIT=0.5
APP_PIDS_LIMIT=128
